/* --- ESTILOS COMPORTAMIENTO GLOBAL Y VARIABLES --- */
:root {
    --bg-principal: #0b0b0b;
    --bg-secundario: #141414;
    --color-oro: #d4af37;
    --color-oro-brillante: #f3e5ab;
    --texto-blanco: #ffffff;
    --texto-gris: #aaaaaa;
    --fuente-global: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--fuente-global);
    background-color: var(--bg-principal);
    color: var(--texto-blanco);
    line-height: 1.6;
}
img {
    width: 100%;       
       height: auto;      
    max-width: 500px; 
}

/* --- BARRA DE NAVEGACIÓN --- */
header {
    background-color: rgba(11, 11, 11, 0.95);
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 2rem;
}

.logo {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--color-oro);
    text-transform: uppercase;
    letter-spacing: 2px;
}

.nav-menu {
    display: flex;
    list-style: none;
    gap: 2rem;
}

.nav-menu a {
    color: var(--texto-blanco);
    text-decoration: none;
    font-size: 1rem;
    transition: color 0.3s ease;
}

.nav-menu a:hover {
    color: var(--color-oro);
}

/* --- SECCIÓN HÉROE / PORTADA --- */
.hero {
    height: 80vh;
    background: linear-gradient(rgba(0,0,0,0.4), var(--bg-principal)), 
                url('https://unsplash.com') no-repeat center center/cover;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1rem;
    margin-top: 60px;
}

.hero-content h1 {
    font-size: 4rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--texto-blanco);
    text-shadow: 2px 2px 10px rgba(0,0,0,0.8);
}

.hero-content p {
    font-size: 1.5rem;
    color: var(--color-oro);
    margin-top: 1rem;
    letter-spacing: 2px;
    font-weight: 300;
}

/* --- CONFIGURACIÓN DE SECCIONES --- */
section {
    padding: 5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.titulo-seccion {
    text-align: center;
    font-size: 2.5rem;
    color: var(--color-oro);
    margin-bottom: 3rem;
    text-transform: uppercase;
    position: relative;
}

.titulo-seccion::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background-color: var(--color-oro);
    margin: 0.5rem auto 0;
}

/* --- SECCIÓN BIOGRAFÍA --- */
.bio-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
}

.bio-texto p {
    margin-bottom: 1.5rem;
    color: var(--texto-gris);
    font-size: 1.1rem;
}

.bio-imagen {
    background-color: var(--bg-secundario);
    border: 2px solid var(--color-oro);
    padding: 2rem;
    text-align: center;
    border-radius: 8px;
    box-shadow: 0 10px 20px rgba(0,0,0,0.5);
}

.bio-imagen blockquote {
    font-style: italic;
    font-size: 1.3rem;
    color: var(--color-oro-brillante);
}

.autor-cita {
    color: var(--texto-gris); 
    margin-top: 1rem; 
    font-size: 0.9rem;
}

/* --- SECCIÓN DISCOGRAFÍA --- */
.grid-albumes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
}

.tarjeta-album {
    background-color: var(--bg-secundario);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.05);
    transition: transform 0.3s ease, border-color 0.3s ease;
}

.tarjeta-album:hover {
    transform: translateY(-5px);
    border-color: var(--color-oro);
}

.album-info {
    padding: 1.5rem;
}

.album-anio {
    color: var(--color-oro);
    font-size: 0.9rem;
    font-weight: bold;
}

.album-titulo {
    font-size: 1.3rem;
    margin: 0.3rem 0;
}

.album-desc {
    color: var(--texto-gris);
    font-size: 0.95rem;
}

/* --- PIE DE PÁGINA --- */
footer {
    background-color: var(--bg-secundario);
    text-align: center;
    padding: 2rem;
    margin-top: 4rem;
    border-top: 1px solid rgba(212, 175, 55, 0.2);
    color: var(--texto-gris);
    font-size: 0.9rem;
}

footer span {
    color: var(--color-oro);
}

/* --- DISEÑO RESPONSIVO (MÓVILES) --- */
@media (max-width: 768px) {
    .nav-container {
        flex-direction: column;
        gap: 1rem;
    }
    .hero-content h1 {
        font-size: 2.5rem;
    }
    .bio-container {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
}
